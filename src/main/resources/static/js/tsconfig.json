{
  "compilerOptions": {
    "module": "ES2020",
    "moduleResolution": "bundler",
    "target": "ES2017",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "sourceMap": true,
    "inlineSources": true,
    "sourceRoot": "/js",
    "lib": ["ES2017", "DOM"],
    "types": ["jquery"],
    "typeRoots": ["../../../../node_modules/@types"]
  },
  "include": ["./**/*.ts", "./types/**/*.d.ts"],
  "exclude": [
    "./dist/**",
    "./node_modules/**",
    "./base/type/*Type.ts",
    "./base/type/pditem.ts",
    "./machines.ts"
  ]
}
